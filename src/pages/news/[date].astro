---
/**
 * 历史某天的 AI 资讯
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsBoard from '../../components/NewsBoard.astro';
import DateNav from '../../components/DateNav.astro';
import { listNewsDates, getNewsSnapshot, getAdjacentNewsDates } from '../../lib/snapshots';

export async function getStaticPaths() {
  return listNewsDates().map((date) => ({ params: { date } }));
}

const date = Astro.params.date ?? '';
const snapshot = getNewsSnapshot(date);
const nav = getAdjacentNewsDates(date);
const latest = listNewsDates()[0] ?? null;
---

<BaseLayout
  title={`${date} 的 AI 资讯`}
  description={`${date} 当天抓取的 AI 领域资讯存档。`}
>
  <PageHeader
    title={`${date} 的 AI 资讯`}
    description="这是当天抓取结果的存档快照，不会被后来的数据覆盖。"
  />

  <DateNav date={date} prev={nav.prev} next={nav.next} latest={latest} base="/news" />

  {
    snapshot ? (
      <NewsBoard snapshot={snapshot} />
    ) : (
      <div class="empty-state">这一天没有资讯数据。</div>
    )
  }
</BaseLayout>
