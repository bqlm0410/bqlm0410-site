  "version": "1.0.0",
  "private": true,
  "description": "青苺ちゃん的小窝 —— bqlm0410.top 个人网站",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
